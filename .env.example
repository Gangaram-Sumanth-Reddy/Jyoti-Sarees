# Copy to .env.local and fill in. Never commit real values.
#
# Server-only. Do NOT prefix these with NEXT_PUBLIC_ — that would ship them to
# the browser. They are read only by lib/server/data-store.ts.
# Apply supabase/migrations/*.sql to the project before enabling.
#
# Until both are set, forms still validate and hand off to WhatsApp/email,
# but nothing is saved.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- SEO (see SEO.md) ---
# Production domain, no trailing slash. Used for canonicals, sitemap, robots
# and structured data. Falls back to the Vercel production URL, then localhost.
NEXT_PUBLIC_SITE_URL=
# Optional X/Twitter handle, e.g. @jyotisarees. Leave empty if none.
NEXT_PUBLIC_TWITTER_HANDLE=

# Verified business details for Organization structured data. Leave empty
# until confirmed — empty values are omitted, never guessed.
BUSINESS_LEGAL_NAME=
BUSINESS_EMAIL=
# E.164 format, e.g. +919876543210
BUSINESS_PHONE=
# Comma-separated official profile URLs (Instagram, Facebook, YouTube…)
BUSINESS_SOCIAL_PROFILES=
BUSINESS_GOOGLE_PROFILE_URL=
